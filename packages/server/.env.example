# Server Configuration
PORT=3001

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Mailtrap SDK Email Sending Configuration
MAILTRAP_TOKEN=your_mailtrap_api_token
SENDER_EMAIL=hello@productdesign.rockbot.com
SENDER_NAME="Prototype Feedback"
ADMIN_EMAIL=ryan.mccarthy@rockbot.com

# SMTP Fallback Configuration (Optional)
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=your_mailtrap_api_token
SMTP_FROM="Prototype Feedback <no-reply@prototype-feedback.dev>"
