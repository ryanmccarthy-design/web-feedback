# Server Configuration
PORT=3001

# Slack Integration
# Paste your Slack Incoming Webhook URL here to receive real-time notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email Notification Configuration (Nodemailer)
ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user@ethereal.email
SMTP_PASS=your-ethereal-password
SMTP_FROM="Prototype Feedback <no-reply@prototype-feedback.dev>"
